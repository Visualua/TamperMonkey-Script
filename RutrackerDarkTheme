// ==UserScript==
// @name         RuTracker DarkTheme 1.0
// @namespace    http://tampermonkey.net/
// @version      2.0
// @description  Современная тёмная тема RuTracker: узкая колонка, карточки раздач, фильтры со списком, «Отменить», автоподгрузка страниц
// @author       0x0056
// @match        *://rutracker.org/forum/viewforum.php*
// @match        *://rutracker.net/forum/viewforum.php*
// @match        *://*.rutracker.org/forum/viewforum.php*
// @match        *://*.rutracker.net/forum/viewforum.php*
// @match        *://rutracker.org/forum/viewtopic.php*
// @match        *://rutracker.net/forum/viewtopic.php*
// @match        *://*.rutracker.org/forum/viewtopic.php*
// @match        *://*.rutracker.net/forum/viewtopic.php*
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_addStyle
// @run-at       document-start
// ==/UserScript==

/*
 * Хранилище совместимо с 1.0: GM_getValue('hiddenTorrents') = { "текст": {count, kw?} }.
 *   - правило без kw — НАЗВАНИЕ игры: скрывает раздачу, если название (или одно из названий через « / ») совпадает
 *     с правилом без учёта регистра, либо правило встречается в заголовке целым словом;
 *   - kw: true — «слово»: скрывает, если встречается в заголовке где угодно (так работали JPN, [Scene], [Portable]).
 */
(function () {
    'use strict';

    const IS_TOPIC = /viewtopic\.php/.test(location.pathname);
    const PRESETS = ['JPN', '[Scene]', '[Portable]'];
    const AUTOLOAD_MIN_VISIBLE = 20;   // догружать следующие страницы, пока видно меньше стольких раздач
    const AUTOLOAD_MAX_PAGES = 6;

    let rules = GM_getValue('hiddenTorrents', {});
    for (const p of PRESETS) if (rules[p]) rules[p].kw = true;
    let showHidden = GM_getValue('rtShowHidden', false);
    const save = () => GM_setValue('hiddenTorrents', rules);

    // ------------------------------------------------------------------ стили
    GM_addStyle(`
    :root {
        --bg: #0a0c12; --surface: #11141d; --surface-2: #161a25; --surface-3: #1d2230;
        --line: rgba(255,255,255,.07); --line-2: rgba(255,255,255,.12);
        --text: #e7e9f0; --muted: #8a90a6; --faint: #5d6377;
        --accent: #8b7bff; --accent-2: #39c6f4; --grad: linear-gradient(135deg, #8b7bff 0%, #39c6f4 100%);
        --green: #3ddc97; --orange: #ffb547; --red: #ff5c7a;
        --r: 14px; --r-sm: 9px;
        --font: "Inter", "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
        --shadow: 0 10px 30px rgba(0,0,0,.35);
        color-scheme: dark;
    }
    html, body { background: var(--bg) !important; }
    body {
        color: var(--text) !important; font: 14px/1.5 var(--font) !important; letter-spacing: .1px;
        margin: 0 !important; -webkit-font-smoothing: antialiased;
    }
    body::before {
        content: ""; position: fixed; inset: 0; z-index: -1; pointer-events: none;
        background:
            radial-gradient(900px 500px at 15% -10%, rgba(139,123,255,.13), transparent 60%),
            radial-gradient(800px 500px at 100% 0%, rgba(57,198,244,.09), transparent 60%),
            var(--bg);
    }
    /* убираем белые фоны сайта, но только внутри страницы */
    :where(#body_container) :where(div, span, p, td, th, table, tr, tbody, ul, li, fieldset, legend, label) {
        background-color: transparent !important; border-color: var(--line) !important;
    }
    #body_container, #page_container, #page_content, #main_content, #main_content_wrap { background: transparent !important; }
    #page_container { max-width: 1440px !important; margin: 0 auto !important; padding: 0 28px 60px !important; box-sizing: border-box; }
    a, a:visited { color: #b9b1ff !important; text-decoration: none !important; transition: color .15s; }
    a:hover { color: #fff !important; }
    ::selection { background: rgba(139,123,255,.45); }
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #262b3b; border-radius: 10px; border: 2px solid var(--bg); }
    ::-webkit-scrollbar-thumb:hover { background: #343a50; }

    /* шапка */
    #page_header { background: transparent !important; box-shadow: none !important; }
    #main-nav {
        position: sticky; top: 0; z-index: 50; margin: 0 -28px 8px !important; padding: 10px 28px !important;
        background: rgba(10,12,18,.72) !important; backdrop-filter: blur(14px) saturate(140%);
        border: 0 !important; border-bottom: 1px solid var(--line) !important; border-radius: 0 !important;
    }
    #main-nav a { color: var(--muted) !important; font-weight: 500; }
    #main-nav a:hover { color: var(--text) !important; }
    #logo { padding: 14px 0 6px !important; }
    #logo img { height: 34px !important; width: auto !important; filter: saturate(1.1); }
    .topmenu { background: transparent !important; border: 0 !important; padding: 6px 0 !important; }
    #logged-in-username { color: var(--text) !important; font-weight: 600 !important; }
    .log-out-icon { filter: invert(1) opacity(.55) !important; }

    /* поля ввода и кнопки сайта */
    #body_container input[type="text"], #body_container input[type="search"], #body_container input[type="password"],
    #body_container select, #body_container textarea {
        background: var(--surface-2) !important; color: var(--text) !important; border: 1px solid var(--line-2) !important;
        border-radius: var(--r-sm) !important; padding: 7px 11px !important; font: inherit !important; outline: none !important;
        box-shadow: none !important; transition: border-color .15s, box-shadow .15s;
    }
    #body_container input:focus, #body_container select:focus, #body_container textarea:focus {
        border-color: var(--accent) !important; box-shadow: 0 0 0 3px rgba(139,123,255,.2) !important;
    }
    #body_container input[type="submit"], #body_container input[type="button"], #body_container button:not(.rtm-btn):not(.rtm-icon):not(.rtm-hide),
    #search-submit {
        background: var(--surface-3) !important; color: var(--text) !important; border: 1px solid var(--line-2) !important;
        border-radius: var(--r-sm) !important; padding: 7px 14px !important; cursor: pointer; font: 500 13px var(--font) !important;
    }
    #search-submit { background: var(--grad) !important; border: 0 !important; color: #fff !important; }
    #search-text { min-width: 260px !important; }

    /* общие таблицы форума */
    .forumline, .vf-table {
        background: var(--surface) !important; border: 1px solid var(--line) !important; border-radius: var(--r) !important;
        overflow: hidden; box-shadow: var(--shadow); border-collapse: separate !important;
    }
    .forumline th, .vf-table th, .thHead {
        background: var(--surface-2) !important; color: var(--muted) !important; font: 600 11px var(--font) !important;
        text-transform: uppercase; letter-spacing: .08em; padding: 10px 12px !important; border: 0 !important;
        border-bottom: 1px solid var(--line) !important;
    }
    .row1, .row2, .row4, .row5, .prow1, .prow2 { background: transparent !important; }
    .row3, td.catTitle, td.cat {
        background: var(--surface-2) !important; color: var(--text) !important; border: 0 !important;
        font: 600 13px var(--font) !important; padding: 10px 14px !important;
    }
    .maintitle, h1.maintitle { font: 700 26px/1.25 var(--font) !important; letter-spacing: -.3px; margin: 10px 0 6px !important; }
    .maintitle a { color: var(--text) !important; }
    .nav, .nav a { color: var(--muted) !important; font-size: 13px; }
    .nav a:hover { color: var(--text) !important; }
    .seedmed, .seed, .seedmed b { color: var(--green) !important; }
    .leechmed, .leech, .leechmed b { color: var(--orange) !important; }
    .tor-approved { color: var(--green) !important; }
    .tor-not-approved, .tor-dup { color: var(--red) !important; }

    /* ------------------------------------------------ список раздач (viewforum) */
    table.vf-tor { display: block !important; background: transparent !important; border: 0 !important; box-shadow: none !important; overflow: visible; }
    table.vf-tor > colgroup, table.vf-tor > thead, table.vf-tor > tbody > tr:first-child:has(th) { display: none !important; }
    table.vf-tor > tbody { display: flex !important; flex-direction: column; gap: 8px; }
    table.vf-tor > tbody > tr:not(.hl-tr) > td { display: block; }
    table.vf-tor > tbody > tr:not(.hl-tr) > td.row3, table.vf-tor > tbody > tr:not(.hl-tr) > td.catTitle {
        background: transparent !important; color: var(--muted) !important; padding: 14px 4px 2px !important;
        font: 600 11px var(--font) !important; text-transform: uppercase; letter-spacing: .1em;
    }
    tr.hl-tr {
        display: grid !important; grid-template-columns: 34px minmax(0,1fr) 150px 92px 140px 56px; align-items: center;
        background: var(--surface) !important; border: 1px solid var(--line); border-radius: var(--r);
        transition: border-color .15s, background .15s, transform .15s, opacity .2s; position: relative;
    }
    tr.hl-tr:hover { background: var(--surface-2) !important; border-color: var(--line-2); }
    tr.hl-tr > td { display: block; border: 0 !important; padding: 12px 10px !important; background: transparent !important; }
    /* сайт подсвечивает ячейки при наведении (tr.hl-tr:hover td { #f8f8f8 !important }) и выделенные строки — перебиваем */
    #body_container tr.hl-tr > td, #body_container tr.hl-tr:hover > td, #body_container tr.hl-tr[class] > td,
    #body_container .hl-selected-row td, #body_container .hl-sel-row-2 td, #body_container .hl-sel-row-3 td,
    #body_container .p-body tr:hover { background: transparent !important; background-color: transparent !important; }
    #body_container tr.hl-tr.hl-selected-row, #body_container tr.hl-tr.hl-sel-row-2, #body_container tr.hl-tr.hl-sel-row-3 {
        background: var(--surface-2) !important; border-color: rgba(139,123,255,.45) !important; }
    tr.hl-tr > td.vf-col-icon { padding-left: 14px !important; text-align: center; opacity: .8; }
    tr.hl-tr .topic_icon { display: none !important; }
    tr.hl-tr .t-is-unread img, tr.hl-tr .icon-newest { display: none !important; }
    .torTopic { display: flex !important; align-items: center; gap: 8px; min-width: 0; }
    .torTopic .tor-icon { font-size: 11px; opacity: .8; }
    .torTopic .tor-icon.tor-approved { display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: rgba(61,220,151,.14) !important; font-size: 10px; }
    a.tt-text, a.torTopic {
        font: 600 15px/1.35 var(--font) !important; color: var(--text) !important; overflow: hidden; text-overflow: ellipsis;
    }
    tr.hl-tr a.tt-text:visited { color: #a7a9b8 !important; }
    a.tt-text:hover { color: #fff !important; }
    .topicAuthor, .topicAuthor a { color: var(--faint) !important; font-size: 12px !important; font-weight: 400 !important; }
    .rtm-chips { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
    .rtm-chip {
        font: 600 11px/1 var(--font); padding: 4px 7px; border-radius: 6px; color: var(--muted) !important;
        background: var(--surface-3) !important; border: 1px solid var(--line) !important; white-space: nowrap;
    }
    .rtm-chip.year { color: #cfc8ff !important; background: rgba(139,123,255,.14) !important; border-color: rgba(139,123,255,.25) !important; }
    .rtm-chip.lic  { color: #8ff0c4 !important; background: rgba(61,220,151,.12) !important; border-color: rgba(61,220,151,.25) !important; }
    .rtm-chip.rep  { color: #ffd38a !important; background: rgba(255,181,71,.12) !important; border-color: rgba(255,181,71,.25) !important; }
    .rtm-chip.lang { color: #9fe3fb !important; background: rgba(57,198,244,.10) !important; border-color: rgba(57,198,244,.22) !important; }
    .rtm-chip.genre { color: #d9dbe6 !important; }
    .rtm-meta { display: flex; align-items: center; gap: 10px; margin-top: 6px; color: var(--faint); font-size: 12px; }

    td.vf-col-tor { text-align: right !important; }
    td.vf-col-tor .seedmed, td.vf-col-tor .leechmed {
        display: inline-flex; align-items: center; gap: 3px; font: 700 12px var(--font) !important;
        padding: 3px 8px; border-radius: 99px;
    }
    td.vf-col-tor .seedmed { background: rgba(61,220,151,.12) !important; }
    td.vf-col-tor .leechmed { background: rgba(255,181,71,.12) !important; }
    td.vf-col-tor .seedmed::before { content: "▲"; font-size: 8px; }
    td.vf-col-tor .leechmed::before { content: "▼"; font-size: 8px; }
    td.vf-col-tor span.med { display: none; }
    td.vf-col-tor .small { margin-top: 6px; }
    td.vf-col-tor a.f-dl, td.vf-col-tor a.dl-stub { color: var(--text) !important; font: 600 13px var(--font) !important; }
    tr.hl-tr td, tr.hl-tr td * { font-family: var(--font) !important; }
    td.vf-col-replies { text-align: center !important; color: var(--muted) !important; font-size: 12px !important; }
    td.vf-col-replies p { margin: 0 !important; }
    td.vf-col-replies p.med b { color: var(--text); font-weight: 600; }
    td.vf-col-replies p.med b::after { content: " ⤓"; color: var(--faint); font-weight: 400; }
    td.vf-col-replies p:first-child { display: none; }
    td.vf-col-last-post { text-align: right !important; color: var(--muted) !important; font-size: 12px !important; }
    td.vf-col-last-post p { margin: 0 !important; }
    td.vf-col-last-post img { display: none; }
    td.vf-col-last-post a { color: var(--faint) !important; }

    /* кнопка «скрыть» в карточке */
    .rtm-hide {
        justify-self: center; transform: scale(.9); opacity: 0; margin: 0 !important;
        width: 30px; height: 30px; border-radius: 9px; border: 1px solid var(--line-2) !important;
        background: var(--surface-3) !important; color: var(--muted) !important; cursor: pointer; padding: 0 !important;
        display: grid; place-items: center; transition: opacity .15s, transform .15s, background .15s, color .15s;
    }
    tr.hl-tr:hover .rtm-hide { opacity: 1; transform: scale(1); }
    .rtm-hide:hover { background: rgba(255,92,122,.16) !important; color: var(--red) !important; border-color: rgba(255,92,122,.35) !important; }
    .rtm-hide svg { width: 16px; height: 16px; }

    tr.hl-tr.rtm-hidden { display: none !important; }
    body.rtm-show-hidden tr.hl-tr.rtm-hidden { display: grid !important; opacity: .38; }
    body.rtm-show-hidden tr.hl-tr.rtm-hidden:hover { opacity: .8; }
    tr.hl-tr.rtm-hidden .rtm-hide { display: none; }
    tr.hl-tr .rtm-unhide { display: none; }
    body.rtm-show-hidden tr.hl-tr.rtm-hidden .rtm-unhide {
        display: inline-flex; margin-left: 8px; font: 600 11px var(--font); color: var(--accent) !important; cursor: pointer;
        background: rgba(139,123,255,.12) !important; padding: 3px 8px; border-radius: 6px; white-space: nowrap;
    }
    tr.hl-tr.rtm-leaving { opacity: 0; transform: translateX(14px); }
    tr.hl-tr.rtm-new { animation: rtmIn .35s ease both; }
    @keyframes rtmIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

    /* панель над списком */
    .rtm-bar {
        display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 14px 0 10px;
        padding: 10px 12px; background: var(--surface) !important; border: 1px solid var(--line) !important; border-radius: var(--r);
    }
    .rtm-bar .rtm-stat { color: var(--muted); font-size: 13px; margin-right: auto; }
    .rtm-bar .rtm-stat b { color: var(--text); }
    .rtm-btn {
        display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 14px; border-radius: var(--r-sm);
        border: 1px solid var(--line-2) !important; background: var(--surface-3) !important; color: var(--text) !important;
        font: 600 13px var(--font) !important; cursor: pointer; transition: background .15s, border-color .15s, transform .1s;
    }
    .rtm-btn:hover { border-color: rgba(139,123,255,.5) !important; background: #232839 !important; }
    .rtm-btn:active { transform: translateY(1px); }
    .rtm-btn.primary { background: var(--grad) !important; border: 0 !important; color: #fff !important; }
    .rtm-btn.on { border-color: var(--accent) !important; color: #cfc8ff !important; }
    .rtm-btn svg { width: 15px; height: 15px; }
    .rtm-badge { background: rgba(255,255,255,.1) !important; padding: 1px 7px; border-radius: 99px; font-size: 11px; }
    .rtm-more { display: flex; justify-content: center; margin: 16px 0; }
    .rtm-loading { color: var(--muted); font-size: 13px; display: inline-flex; align-items: center; gap: 8px; }
    .rtm-spin { width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--line-2); border-top-color: var(--accent); animation: rtmSpin .7s linear infinite; }
    @keyframes rtmSpin { to { transform: rotate(360deg); } }

    /* боковая панель фильтров */
    .rtm-overlay { position: fixed; inset: 0; background: rgba(5,6,10,.55); backdrop-filter: blur(3px); z-index: 9998; opacity: 0; pointer-events: none; transition: opacity .2s; }
    .rtm-drawer {
        position: fixed; top: 0; right: 0; bottom: 0; width: 440px; max-width: 92vw; z-index: 9999;
        background: var(--surface); border-left: 1px solid var(--line-2); box-shadow: -20px 0 60px rgba(0,0,0,.5);
        transform: translateX(100%); transition: transform .25s cubic-bezier(.2,.8,.2,1); display: flex; flex-direction: column;
        font: 14px/1.5 var(--font); color: var(--text);
    }
    .rtm-open .rtm-overlay { opacity: 1; pointer-events: auto; }
    .rtm-open .rtm-drawer { transform: none; }
    .rtm-drawer header { display: flex; align-items: center; gap: 10px; padding: 18px 20px 14px; border-bottom: 1px solid var(--line); }
    .rtm-drawer header h2 { margin: 0; font: 700 18px var(--font); flex: 1; color: var(--text); }
    .rtm-icon {
        width: 34px; height: 34px; border-radius: 9px; border: 1px solid var(--line-2) !important; background: var(--surface-3) !important;
        color: var(--muted) !important; cursor: pointer; display: grid; place-items: center; padding: 0 !important;
    }
    .rtm-icon:hover { color: var(--text) !important; }
    .rtm-icon svg { width: 16px; height: 16px; }
    .rtm-sec { padding: 14px 20px; border-bottom: 1px solid var(--line); }
    .rtm-sec h3 { margin: 0 0 10px; font: 600 11px var(--font); color: var(--muted); text-transform: uppercase; letter-spacing: .1em; }
    .rtm-add { display: flex; gap: 8px; }
    .rtm-input {
        flex: 1; height: 36px; padding: 0 12px; border-radius: var(--r-sm); border: 1px solid var(--line-2); outline: none;
        background: var(--surface-2); color: var(--text); font: 14px var(--font); min-width: 0;
    }
    .rtm-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(139,123,255,.2); }
    .rtm-seg { display: flex; background: var(--surface-2); border: 1px solid var(--line-2); border-radius: var(--r-sm); padding: 3px; margin-top: 8px; width: max-content; }
    .rtm-seg button { border: 0 !important; background: transparent !important; color: var(--muted) !important; font: 600 12px var(--font) !important; padding: 5px 10px !important; border-radius: 6px !important; cursor: pointer; }
    .rtm-seg button.on { background: var(--surface-3) !important; color: var(--text) !important; }
    .rtm-hint { color: var(--faint); font-size: 12px; margin-top: 8px; }
    .rtm-presets { display: flex; gap: 6px; flex-wrap: wrap; }
    .rtm-list { flex: 1; overflow-y: auto; padding: 6px 12px 16px; }
    .rtm-rule {
        display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--r-sm); transition: background .12s;
    }
    .rtm-rule:hover { background: var(--surface-2); }
    .rtm-rule .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rtm-rule .k { font: 600 10px var(--font); color: var(--accent-2); background: rgba(57,198,244,.1); padding: 2px 6px; border-radius: 5px; text-transform: uppercase; }
    .rtm-rule .c { font: 600 11px var(--font); color: var(--muted); }
    .rtm-rule button { opacity: 0; border: 0 !important; background: transparent !important; color: var(--muted) !important; cursor: pointer; padding: 4px !important; border-radius: 6px; display: grid; }
    .rtm-rule:hover button { opacity: 1; }
    .rtm-rule button:hover { color: var(--red) !important; background: rgba(255,92,122,.12) !important; }
    .rtm-rule button svg { width: 14px; height: 14px; }
    .rtm-empty { color: var(--faint); text-align: center; padding: 30px 10px; }
    .rtm-foot { display: flex; gap: 8px; padding: 12px 20px; border-top: 1px solid var(--line); }
    .rtm-foot .rtm-btn { flex: 1; justify-content: center; }

    /* всплывашка с «Отменить» */
    .rtm-toast {
        position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 20px); opacity: 0; z-index: 10000;
        display: flex; align-items: center; gap: 14px; padding: 10px 10px 10px 16px; border-radius: 12px;
        background: #1f2433; border: 1px solid var(--line-2); box-shadow: var(--shadow); color: var(--text);
        font: 500 14px var(--font); transition: opacity .2s, transform .2s; max-width: 80vw;
    }
    .rtm-toast.show { opacity: 1; transform: translate(-50%, 0); }
    .rtm-toast .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    /* ------------------------------------------------ страница раздачи (viewtopic) */
    #topic_main { background: transparent !important; border: 0 !important; box-shadow: none !important; border-spacing: 0 12px !important; }
    #topic_main > tbody > tr > td { border: 0 !important; }
    #topic_main > tbody[id^="post_"] > tr > td, #topic_main > tbody.row1 > tr > td, #topic_main > tbody.row2 > tr > td { background: var(--surface) !important; }
    #topic_main > tbody > tr:first-child > td:first-child { border-top-left-radius: var(--r); }
    #topic_main > tbody > tr:first-child > td:last-child { border-top-right-radius: var(--r); }
    #topic_main > tbody > tr:last-child > td:first-child { border-bottom-left-radius: var(--r); }
    #topic_main > tbody > tr:last-child > td:last-child { border-bottom-right-radius: var(--r); }
    #topic_main > tbody > tr:not(:first-child) > td { border-top: 1px solid var(--line) !important; }
    fieldset { border: 1px solid var(--line-2) !important; border-radius: var(--r) !important; }
    fieldset legend { color: var(--muted) !important; padding: 0 6px; }
    td.poster_info { width: 150px !important; padding: 16px !important; color: var(--muted) !important; font-size: 12px !important; border-right: 1px solid var(--line) !important; }
