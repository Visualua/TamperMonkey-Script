    td.poster_info img { border-radius: 10px; max-width: 100px; height: auto; }
    td.message { padding: 16px 20px !important; }
    .post_head { color: var(--faint) !important; font-size: 12px !important; border-bottom: 1px solid var(--line) !important; padding-bottom: 8px !important; margin-bottom: 12px; }
    .post_body { font: 15px/1.65 var(--font) !important; color: #d6d9e3 !important; max-width: 1100px; }
    .post_body .post-b { color: var(--text); }
    .post_body var.postImg, .post_body img.postImg { border-radius: 10px; }
    .post_body .postImgAligned.img-right { margin-left: 18px !important; }
    .post_body hr, .post-hr { border: 0 !important; border-top: 1px solid var(--line) !important; }
    .post_body .q-wrap, .post_body .q {
        background: var(--surface-2) !important; border: 0 !important; border-left: 3px solid var(--accent) !important;
        border-radius: var(--r-sm); padding: 10px 14px !important;
    }
    .post_body .c-wrap, .post_body .c-body, .post_body pre {
        background: #0c0e14 !important; border: 1px solid var(--line) !important; border-radius: var(--r-sm);
        font: 13px/1.5 "Cascadia Code", Consolas, monospace !important; color: #cdd3e4 !important;
    }
    .sp-wrap {
        background: var(--surface-2) !important; border: 1px solid var(--line) !important; border-radius: var(--r-sm) !important;
        margin: 8px 0 !important; overflow: hidden; width: auto !important;
    }
    .sp-head {
        background: transparent !important; padding: 10px 14px !important; cursor: pointer; border: 0 !important;
        font: 600 14px var(--font) !important; color: var(--text) !important; display: flex !important; align-items: center; gap: 8px;
    }
    .sp-head::before { content: "›"; display: inline-block; transition: transform .15s; color: var(--muted); font-size: 18px; line-height: 1; }
    .sp-head.unfolded::before { transform: rotate(90deg); }
    .sp-head:hover { background: var(--surface-3) !important; }
    .sp-head, .sp-head * { color: var(--text) !important; }
    .sp-body { padding: 12px 16px !important; border-top: 1px solid var(--line) !important; background: transparent !important; }

    /* блок скачивания */
    table.attach {
        background: var(--surface-2) !important; border: 1px solid rgba(139,123,255,.25) !important; border-radius: var(--r) !important;
        overflow: hidden; margin: 14px 0 !important; border-collapse: separate !important; box-shadow: 0 0 0 4px rgba(139,123,255,.05);
    }
    table.attach td { padding: 6px 14px !important; color: var(--muted); }
    table.attach tr.row3 td { background: transparent !important; color: var(--faint) !important; font-size: 12px !important; font-weight: 500 !important; }
    table.attach a.dl-link {
        display: inline-flex !important; align-items: center; gap: 8px; padding: 9px 16px !important; border-radius: var(--r-sm);
        background: var(--grad) !important; color: #fff !important; font: 700 14px var(--font) !important; box-shadow: 0 6px 18px rgba(139,123,255,.3);
    }
    table.attach a.dl-link:hover { filter: brightness(1.1); }
    table.attach a.magnet-link, table.attach a.magnet-link-16 { color: var(--accent-2) !important; font-weight: 600; }
    #tor-size-humn, table.attach b { color: var(--text) !important; }

    /* лишнее (как в 1.0) */
    #post-msg-form, #thx-btn-div, #forum-moderators, #nav-panel, #jumpbox-wrap, #footer-info-links,
    #bn-top-right, .bn-idx, #idx-sidebar2 .bn-idx, a.t-is-unread > img { display: none !important; }
    `);

    // ------------------------------------------------------------------ утилиты
    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const el = (tag, cls, html) => { const e = document.createElement(tag); if (cls) e.className = cls; if (html != null) e.innerHTML = html; return e; };
    const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const ICON = {
        eyeOff: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>',
        eye: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
        filter: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>',
        x: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
    };

    // название игры из заголовка: «[DL] Name / Alt [L] [RUS] (2025)» → «Name / Alt»
    const gameName = title => {
        const m = title.match(/^\s*(?:\[[^\]]*\]\s*)*([^[(]+)/);
        return m ? m[1].trim().replace(/\s+/g, ' ') : title.trim();
    };
    const norm = s => s.toLowerCase().replace(/[’`]/g, "'").replace(/\s+/g, ' ').trim();
    const reEsc = s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    let matcherCache = null;
    const buildMatcher = () => {
        const names = new Map();               // norm(name) -> rule key
        const words = [];                      // [key, RegExp] — целым словом (старые правила)
        const kws = [];                        // [key, lowercase text] — где угодно
        for (const [k, v] of Object.entries(rules)) {
            if (v.kw) { kws.push([k, k.toLowerCase()]); continue; }
            names.set(norm(k), k);
            words.push([k, new RegExp('(^|[^\\p{L}\\p{N}])' + reEsc(k) + '($|[^\\p{L}\\p{N}])', 'u')]);
        }
        matcherCache = { names, words, kws };
    };
    const matchRule = title => {
        if (!matcherCache) buildMatcher();
        const { names, words, kws } = matcherCache;
        const name = gameName(title);
        const full = norm(name);
        if (names.has(full)) return names.get(full);
        for (const part of name.split(/\s+\/\s+/)) { const p = norm(part); if (names.has(p)) return names.get(p); }
        const low = title.toLowerCase();
        for (const [k, w] of kws) if (low.includes(w)) return k;
        for (const [k, re] of words) if (re.test(title)) return k;
        return null;
    };

    // ------------------------------------------------------------------ список раздач
    const CHIP_RULES = [
        [/^(19|20)\d\d$/, 'year'], [/^L$/, 'lic', 'Лицензия'], [/^P$/, 'rep', 'Пиратка'], [/^RePack/i, 'rep'],
        [/^(GOG|Steam|Steam-Rip|EGS|Epic)/i, 'lic'], [/(RUS|ENG|JPN|MULTI|UKR|GER|CHI)/, 'lang'],
    ];
    const chipsFromTitle = title => {
        const out = [];
        const tags = [...title.matchAll(/\[([^\]]+)\]|\(([^)]+)\)/g)].map(m => (m[1] || m[2]).trim());
        const parts = [];                                   // [текст, принудительный класс]
        for (const t of tags) {
            const y = t.match(/^((?:19|20)\d\d)\s*,\s*(.+)$/);  // «2026, RPG» → год + жанр
            if (y) parts.push([y[1], 'year'], [y[2], 'genre']); else parts.push([t, '']);
        }
        for (const [t, forced] of parts) {
            if (/^DL$/i.test(t) || /^\d{6,}$/.test(t)) continue;  // номера сборок Steam — шум
            let cls = forced, label = t;
            if (!cls) for (const [re, c, l] of CHIP_RULES) if (re.test(t)) { cls = c; if (l) label = l; break; }
            out.push(`<span class="rtm-chip ${cls}">${esc(label)}</span>`);
        }
        return out.slice(0, 7).join('');
    };

    const processRow = row => {
        if (row.dataset.rtm) return;
        row.dataset.rtm = '1';
        const a = $('a.tt-text', row);
        if (!a) return;
        const title = a.dataset.full || a.textContent.trim();
        a.dataset.full = title;
        a.title = title;
        a.textContent = gameName(title);
        const topic = a.parentElement.closest('div.torTopic') || a.parentElement;   // у самой ссылки тоже класс torTopic
        for (const n of [...topic.childNodes]) if (n.nodeType === 3 && /^[\s·•|]*$/.test(n.textContent)) n.remove();   // «·» между значком и названием
        const chips = chipsFromTitle(title);
        if (chips && !$('.rtm-chips', row)) topic.insertAdjacentElement('afterend', el('div', 'rtm-chips', chips));
        // старые иконки → компактные значки
        const icon = $('td.vf-col-icon', row);
        if (icon) {
            const img = $('img.topic_icon', icon);
            const src = img ? img.getAttribute('src') || '' : '';
            if (/sticky|announce/.test(src)) icon.insertAdjacentHTML('beforeend', '📌');
            else if (/lock/.test(src)) icon.insertAdjacentHTML('beforeend', '🔒');
            else if (/_new/.test(src) || $('.t-is-unread', row)) icon.insertAdjacentHTML('beforeend', '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent)"></span>');
        }
        $$('span.ttp-label.ttp-hot', row).forEach(l => { l.textContent = '🔥'; l.style.cssText = 'background:none;padding:0;font-size:15px'; });
        $$('span.topicPoll', row).forEach(l => { l.textContent = '📊'; });
        if (!isTor(row)) return;
        const hide = el('button', 'rtm-hide', ICON.eyeOff);
        hide.title = 'Скрыть эту игру';
        hide.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); hideGame(row); });
        row.appendChild(hide);
        const unhide = el('span', 'rtm-unhide', 'Показать снова');
        unhide.addEventListener('click', e => { e.preventDefault(); removeRule(row.dataset.rule); });
        topic.appendChild(unhide);
    };

    const tbody = () => $('table.vf-tor > tbody') || $('table.vf-table > tbody');
    const isTor = r => !!$('a.tt-text', r) && !!$('a.f-dl, a.dl-stub, .seedmed', r);   // раздача, а не закреплённая тема
    const torRows = () => $$('tr.hl-tr').filter(isTor);

    const applyFilters = () => {
        matcherCache = null;
        for (const k in rules) rules[k].count = 0;
        let hidden = 0;
        for (const row of torRows()) {
            const k = matchRule($('a.tt-text', row).dataset.full || $('a.tt-text', row).textContent);
            row.classList.toggle('rtm-hidden', !!k);
            if (k) { row.dataset.rule = k; rules[k].count++; hidden++; } else delete row.dataset.rule;
        }
        updateBar(hidden);
        return hidden;
    };

    let bar, statEl, toggleBtn, filtersBtn, moreWrap;
    const visibleCount = () => torRows().filter(r => !r.classList.contains('rtm-hidden')).length;
    const updateBar = hidden => {
        if (!bar) return;
        const total = torRows().length;
        hidden = hidden ?? torRows().filter(r => r.classList.contains('rtm-hidden')).length;
        statEl.innerHTML = `Показано <b>${total - hidden}</b> из ${total}` + (hidden ? ` · скрыто <b>${hidden}</b>` : '') +
            (pagesLoaded > 1 ? ` · страниц: <b>${pagesLoaded}</b>` : '');
        toggleBtn.innerHTML = (showHidden ? ICON.eye : ICON.eyeOff) + (showHidden ? 'Скрытые видны' : 'Показать скрытые');
        toggleBtn.classList.toggle('on', showHidden);
        filtersBtn.innerHTML = `${ICON.filter}Фильтры <span class="rtm-badge">${Object.keys(rules).length}</span>`;
    };

    const buildBar = () => {
        const table = $('table.vf-tor') || $('table.vf-table');
        if (!table) return;
        bar = el('div', 'rtm-bar');
        statEl = el('div', 'rtm-stat');
        toggleBtn = el('button', 'rtm-btn');
        toggleBtn.addEventListener('click', () => {
            showHidden = !showHidden; GM_setValue('rtShowHidden', showHidden);
            document.body.classList.toggle('rtm-show-hidden', showHidden); updateBar();
        });
        filtersBtn = el('button', 'rtm-btn');
        filtersBtn.addEventListener('click', openDrawer);
        bar.append(statEl, toggleBtn, filtersBtn);
        table.parentNode.insertBefore(bar, table);
        moreWrap = el('div', 'rtm-more');
        table.parentNode.insertBefore(moreWrap, table.nextSibling);
        document.body.classList.toggle('rtm-show-hidden', showHidden);
    };

    // ---------------- автоподгрузка следующих страниц
    let nextUrl = null, pagesLoaded = 1, loading = false;
    const findNext = doc => {
        const a = $$('a.pg', doc).find(x => /След/.test(x.textContent));
        return a ? new URL(a.getAttribute('href'), location.href).href : null;
    };
    const renderMore = () => {
        if (!moreWrap) return;
        moreWrap.innerHTML = '';
        if (loading) { moreWrap.append(el('span', 'rtm-loading', '<span class="rtm-spin"></span>Загружаю следующую страницу…')); return; }
        if (!nextUrl) return;
        const b = el('button', 'rtm-btn', 'Загрузить ещё');
        b.addEventListener('click', () => loadNext());
        moreWrap.append(b);
    };
    const loadNext = async () => {
        if (loading || !nextUrl) return false;
        loading = true; renderMore();
        try {
            const resp = await fetch(nextUrl, { credentials: 'include' });
            const buf = await resp.arrayBuffer();     // сайт в windows-1251 — .text() испортил бы кириллицу
            const cs = ((resp.headers.get('content-type') || '').match(/charset=([\w-]+)/i) || [])[1] || document.characterSet || 'windows-1251';
            const html = new TextDecoder(cs).decode(buf);
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const rows = $$('tr.hl-tr', doc).filter(r => isTor(r) && !document.getElementById(r.id));
            const body = tbody();
            for (const r of rows) {
                const node = document.importNode(r, true);
                node.classList.add('rtm-new');
                body.appendChild(node);
                processRow(node);
            }
            nextUrl = findNext(doc);
            pagesLoaded++;
            applyFilters();
            return true;
        } catch (e) {
            console.warn('[rtm] load next', e);
            return false;
        } finally {
            loading = false; renderMore();
        }
    };
    const autoFill = async () => {
        while (!showHidden && visibleCount() < AUTOLOAD_MIN_VISIBLE && nextUrl && pagesLoaded < AUTOLOAD_MAX_PAGES) {
            if (!(await loadNext())) break;
        }
    };

    // ---------------- скрытие / правила
    let toast, toastTimer;
    const showToast = (text, undo) => {
        if (!toast) { toast = el('div', 'rtm-toast'); document.body.appendChild(toast); }
        toast.innerHTML = `<span class="t">${esc(text)}</span>`;
        if (undo) {
            const b = el('button', 'rtm-btn', 'Отменить');
            b.addEventListener('click', () => { undo(); toast.classList.remove('show'); });
            toast.appendChild(b);
        }
        requestAnimationFrame(() => toast.classList.add('show'));
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 5000);
    };

    const addRule = (text, kw = false) => {
        text = text.trim();
        if (!text || rules[text]) return false;
        rules[text] = kw ? { count: 0, kw: true } : { count: 0 };
        save(); return true;
    };
    const removeRule = key => {
        if (!key || !rules[key]) return;
        delete rules[key]; save(); applyFilters(); renderRules();
        showToast(`Снова показываю: ${key}`, () => { rules[key] = { count: 0 }; save(); applyFilters(); renderRules(); });
    };
    const hideGame = row => {
        const a = $('a.tt-text', row);
        const name = gameName(a.dataset.full || a.textContent);
        if (!addRule(name)) return;
        row.classList.add('rtm-leaving');
        setTimeout(() => { row.classList.remove('rtm-leaving'); applyFilters(); autoFill(); }, 180);
        showToast(`Скрыто: ${name}`, () => { delete rules[name]; save(); applyFilters(); });
    };

    // ---------------- панель фильтров
    let drawerRoot, listEl, searchEl, addEl, addKw = false;
    const renderRules = () => {
        if (!listEl) return;
        const q = norm(searchEl.value || '');
        const items = Object.entries(rules)
            .filter(([k]) => !q || norm(k).includes(q))
            .sort((x, y) => (y[1].count || 0) - (x[1].count || 0) || x[0].localeCompare(y[0]));
        listEl.innerHTML = '';
        if (!items.length) { listEl.append(el('div', 'rtm-empty', q ? 'Ничего не найдено' : 'Фильтров пока нет')); return; }
        const frag = document.createDocumentFragment();
        for (const [k, v] of items.slice(0, 400)) {
            const r = el('div', 'rtm-rule',
                `<span class="t" title="${esc(k)}">${esc(k)}</span>${v.kw ? '<span class="k">слово</span>' : ''}` +
                (v.count ? `<span class="c">${v.count} на стр.</span>` : '') + `<button title="Удалить">${ICON.x}</button>`);
            r.querySelector('button').addEventListener('click', () => removeRule(k));
            frag.append(r);
        }
        if (items.length > 400) frag.append(el('div', 'rtm-empty', `…и ещё ${items.length - 400}. Уточни поиск.`));
        listEl.append(frag);
    };
    const buildDrawer = () => {
        drawerRoot = el('div', '');
        drawerRoot.innerHTML = `
          <div class="rtm-overlay"></div>
          <aside class="rtm-drawer">
            <header><h2>Фильтры</h2><button class="rtm-icon" data-close title="Закрыть">${ICON.x}</button></header>
            <div class="rtm-sec">
              <h3>Добавить</h3>
              <div class="rtm-add"><input class="rtm-input" data-add placeholder="Название игры или слово…"><button class="rtm-btn primary" data-addbtn>Скрыть</button></div>
              <div class="rtm-seg"><button data-mode="name" class="on">Название</button><button data-mode="kw">Слово в заголовке</button></div>
              <div class="rtm-hint" data-hint></div>
            </div>
            <div class="rtm-sec">
              <h3>Быстрые</h3>
              <div class="rtm-presets">${PRESETS.map(p => `<button class="rtm-btn" data-preset="${esc(p)}">Скрыть ${esc(p)}</button>`).join('')}</div>
            </div>
            <div class="rtm-sec" style="padding-bottom:10px"><input class="rtm-input" data-search placeholder="Поиск по фильтрам…" style="width:100%;box-sizing:border-box"></div>
            <div class="rtm-list"></div>
            <div class="rtm-foot"><button class="rtm-btn" data-export>Сохранить в файл</button><button class="rtm-btn" data-import>Загрузить из файла</button></div>
          </aside>`;
        document.body.appendChild(drawerRoot);
        listEl = $('.rtm-list', drawerRoot);
        searchEl = $('[data-search]', drawerRoot);
        addEl = $('[data-add]', drawerRoot);
        const hint = $('[data-hint]', drawerRoot);
        const setMode = kw => {
            addKw = kw;
            $$('.rtm-seg button', drawerRoot).forEach(b => b.classList.toggle('on', (b.dataset.mode === 'kw') === kw));
            hint.textContent = kw ? 'Скроет все раздачи, где это встречается в заголовке (например «JPN», «[Portable]»).'
                                  : 'Скроет игру с точно таким названием.';
        };
        setMode(false);
        $$('.rtm-seg button', drawerRoot).forEach(b => b.addEventListener('click', () => setMode(b.dataset.mode === 'kw')));
        const doAdd = () => {
            if (addRule(addEl.value, addKw)) { addEl.value = ''; applyFilters(); renderRules(); autoFill(); }
        };
        $('[data-addbtn]', drawerRoot).addEventListener('click', doAdd);
        addEl.addEventListener('keydown', e => { if (e.key === 'Enter') doAdd(); });
        searchEl.addEventListener('input', renderRules);
        $$('[data-preset]', drawerRoot).forEach(b => b.addEventListener('click', () => {
            if (addRule(b.dataset.preset, true)) { applyFilters(); renderRules(); autoFill(); }
        }));
        $('[data-close]', drawerRoot).addEventListener('click', closeDrawer);
        $('.rtm-overlay', drawerRoot).addEventListener('click', closeDrawer);
        $('[data-export]', drawerRoot).addEventListener('click', () => {
            const blob = new Blob([JSON.stringify(rules, null, 1)], { type: 'application/json' });
            const a = el('a'); a.href = URL.createObjectURL(blob); a.download = 'rutracker-filters.json'; a.click();
            setTimeout(() => URL.revokeObjectURL(a.href), 2000);
        });
        $('[data-import]', drawerRoot).addEventListener('click', () => {
            const inp = el('input'); inp.type = 'file'; inp.accept = '.json,application/json';
            inp.addEventListener('change', async () => {
                try {
                    const data = JSON.parse(await inp.files[0].text());
                    let n = 0;
                    for (const [k, v] of Object.entries(data)) if (!rules[k]) { rules[k] = { count: 0, ...(v && v.kw ? { kw: true } : {}) }; n++; }
                    save(); applyFilters(); renderRules(); showToast(`Добавлено фильтров: ${n}`);
                } catch (e) { showToast('Не удалось прочитать файл'); }
            });
            inp.click();
        });
        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
    };
    const openDrawer = () => {
        if (!drawerRoot) buildDrawer();
        renderRules();
        document.documentElement.classList.add('rtm-open');
        setTimeout(() => addEl.focus(), 200);
    };
    const closeDrawer = () => document.documentElement.classList.remove('rtm-open');

    // ------------------------------------------------------------------ запуск
    const initForum = () => {
        if (!torRows().length) return;
        torRows().forEach(processRow);
        buildBar();
        nextUrl = findNext(document);
        applyFilters();
        renderMore();
        autoFill();
        // подгрузка при прокрутке до конца
        if (moreWrap && 'IntersectionObserver' in window) {
            new IntersectionObserver(es => { if (es.some(e => e.isIntersecting)) loadNext(); }, { rootMargin: '600px' }).observe(moreWrap);
        }
    };

    const initTopic = () => {
        // спойлеры: отметка раскрытого состояния для стрелки
        document.addEventListener('click', e => {
            const h = e.target.closest('.sp-head');
            if (h) setTimeout(() => h.classList.toggle('unfolded', !!(h.nextElementSibling && h.nextElementSibling.offsetParent)), 0);
        }, true);
    };

    const init = () => {
        if (document.documentElement.dataset.rtmInit) return;
        document.documentElement.dataset.rtmInit = '1';
        if (IS_TOPIC) initTopic(); else initForum();
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
})();
